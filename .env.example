# Required for /admin/invoices access. Use a long random session secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: override the central invoice service price catalog.
# JSON keys must match service ids in lib/services.ts.
INVOICE_SERVICE_PRICES_JSON={"air-conditioning":149,"heating":149,"mini-split-systems":199,"quiet-cool-installation":199,"service-repairs":129,"new-installations":0}

# Used in the invoice footer when available.
NEXT_PUBLIC_SITE_URL=https://example.com
